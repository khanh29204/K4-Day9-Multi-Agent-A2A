# -----------------------------------------------------------------------------
# Environment Variables Example Configuration
# -----------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to '.env':  cp .env.example .env
# 2. Fill in your API key and configuration settings below.
# 3. DO NOT commit '.env' to git!
#
# NOTE: As per section 9 of README.md, MODEL_NAME is HARDCODED in 
# codebase/config.py and must NOT be set in .env.
# -----------------------------------------------------------------------------

# LLM Provider API Settings
MODEL_API_KEY=your_api_key_here
MODEL_BASE_URL=https://openrouter.ai/api/v1  # or http://localhost:11434/v1 for Ollama

# Optional Path Overrides (Defaults to project directories if left blank)
# DATA_DIR=/path/to/data
# INPUT_DIR=/path/to/input
# OUTPUT_DIR=/path/to/output
